    <key>UIUserInterfaceStyle</key><string>Automatic</string>
    <key>UIBackgroundModes</key><array><string>processing</string></array>
    <key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.localphototools.PhotoCleaner.analysis</string></array>
